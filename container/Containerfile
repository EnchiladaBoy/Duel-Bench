# Pinned by digest: a floating tag means the arena silently changes between
# runs, which makes published benchmark results non-reproducible.
# Refresh with: podman image inspect docker.io/library/python:3.12-slim \
#                 --format '{{index .RepoDigests 0}}'
FROM docker.io/library/python@sha256:0568e6111802e74c03e8dda76565cdf4b88881d77de0d9b769846e9dfcb8d80a

RUN apt-get update && apt-get install -y --no-install-recommends \
        bash \
        coreutils \
        curl \
        iproute2 \
        iputils-ping \
        netcat-openbsd \
        nmap \
        procps \
        psmisc \
    && rm -rf /var/lib/apt/lists/*

# Both agents run as the same non-root uid: they can still see and signal each
# other (same uid, shared PID namespace), which is the game, but neither is
# root inside its container. Containers additionally run with --cap-drop=ALL
# and --security-opt=no-new-privileges.
RUN useradd --create-home --uid 1000 battler \
    && mkdir -p /battle \
    && chown -R battler:battler /battle

WORKDIR /battle
USER battler

CMD ["bash"]
